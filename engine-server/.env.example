PORT=8765
HOST=0.0.0.0
ENABLE_SHOGI_ENGINE=1
AMTS_ENGINE_THREADS=4
AMTS_ENGINE_HASH_MB=1024
AMTS_ENGINE_OWN_BOOK=false
AMTS_FINALIZE_DEPTH=24
FV_SCALE=40

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Path to the engine binary to use. Prefer placing engine binaries under `engine-server/engines/`.
# Example: ENGINE_PATH=./engines/mac/YaneuraOu_NNUE_halfKP256-V830Git_APPLEM1
ENGINE_PATH=
# Optional evaluation data directory (engine eval files)
EVAL_DIR=
# Recognition defaults resolve to `engine-server/python/recognition`.
# Override these only if you keep the recognition Python project elsewhere.
SHOGI_DATASET_ROOT=
SHOGI_PREDICTION_SCRIPT=
SHOGI_PREDICTION_MODEL=
