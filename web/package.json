{
  "name": "tsuginoitte-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "cross-env AI_PORT=8766 tsx watch scripts/ai-explanation-server.ts",
    "start:ai": "cross-env AI_PORT=8766 tsx scripts/ai-explanation-server.ts",
    "dev:macbook": "vite --mode macbook",
    "dev:windows-tailscale": "vite --mode windows-tailscale",
    "build": "tsc -b && vite build",
    "build:dev": "npm run build && npm run dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.19.2",
    "openai": "^6.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
